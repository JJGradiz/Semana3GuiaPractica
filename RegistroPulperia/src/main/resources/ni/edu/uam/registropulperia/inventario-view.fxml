<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox nodeOrientation="LEFT_TO_RIGHT" prefHeight="460.0" prefWidth="620.0" spacing="8" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.registropulperia.controller.InventarioController">

    <padding>
       <Insets bottom="12" left="18" right="18" top="12" />
    </padding>

    <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Inventario de Pulpería" />

    <Separator />

    <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #34495e;" text="Registrar Producto" />

    <Label style="-fx-font-size: 12px; -fx-font-weight: bold;" text="Código:" />
    <TextField fx:id="txtCodigo" alignment="TOP_LEFT" prefHeight="25.0" prefWidth="492.0" promptText="Ej: PROD001" />

    <Label style="-fx-font-size: 12px; -fx-font-weight: bold;" text="Nombre:" />
    <TextField fx:id="txtNombre" promptText="Nombre del producto" />

    <Label style="-fx-font-size: 12px; -fx-font-weight: bold;" text="Categoría:" />
    <TextField fx:id="txtCategoria" promptText="Ej: Bebidas, Abarrotes" />

    <Label style="-fx-font-size: 12px; -fx-font-weight: bold;" text="Precio (C$):" />
    <TextField fx:id="txtPrecio" promptText="0.00" />

    <Label style="-fx-font-size: 12px; -fx-font-weight: bold;" text="Cantidad:" />
    <TextField fx:id="txtCantidad" promptText="0" />

    <HBox alignment="CENTER_LEFT" spacing="10">
       <Button onAction="#guardarProducto" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 12px; -fx-padding: 6 16;" text="Guardar Producto" />
       <Button onAction="#limpiarFormulario" style="-fx-background-color: #7f8c8d; -fx-text-fill: white; -fx-font-size: 12px; -fx-padding: 6 16;" text="Limpiar" />
    </HBox>

    <Separator />

    <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #34495e;" text="Buscar Producto (Presione ENTER)" />
    <TextField fx:id="txtBuscar" onKeyPressed="#buscarProducto" promptText="Ingrese código del producto" />

    <Separator />

    <Label fx:id="lblResultado" style="-fx-font-size: 12px;" text="" />
    <Label fx:id="lblInfoProducto" style="-fx-font-size: 11px; -fx-text-fill: #555;" text="" wrapText="true" />

    <TableView fx:id="tablaProductos" prefHeight="140.0" prefWidth="580.0">
       <columns>
           <TableColumn fx:id="colCodigo" prefWidth="90" text="Código" />
           <TableColumn fx:id="colNombre" prefWidth="150" text="Nombre" />
           <TableColumn fx:id="colCategoria" prefWidth="130" text="Categoría" />
           <TableColumn fx:id="colPrecio" prefWidth="100" text="Precio (C$)" />
           <TableColumn fx:id="colCantidad" prefWidth="90" text="Cantidad" />
       </columns>
    </TableView>

</VBox>
