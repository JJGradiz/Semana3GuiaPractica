<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="12" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.registropulperia.controller.InventarioController">

    <padding>
        <Insets bottom="20" left="30" right="30" top="20" />
    </padding>

    <!-- Título -->
    <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Inventario de Pulpería" />

    <Separator />

    <!-- Sección de Registro -->
    <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #34495e;" text="Registrar Producto" />

    <Label style="-fx-font-weight: bold;" text="Código:" />
    <TextField fx:id="txtCodigo" promptText="Ej: PROD001" />

    <Label style="-fx-font-weight: bold;" text="Nombre:" />
    <TextField fx:id="txtNombre" promptText="Nombre del producto" />

    <Label style="-fx-font-weight: bold;" text="Categoría:" />
    <TextField fx:id="txtCategoria" promptText="Ej: Bebidas, Abarrotes" />

    <Label style="-fx-font-weight: bold;" text="Precio (C$):" />
    <TextField fx:id="txtPrecio" promptText="0.00" />

    <Label style="-fx-font-weight: bold;" text="Cantidad:" />
    <TextField fx:id="txtCantidad" promptText="0" />

    <!-- Botones -->
    <HBox spacing="10">
        <Button onAction="#guardarProducto" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 13px; -fx-padding: 8 20;" text="Guardar Producto" />
        <Button onAction="#limpiarCampos" style="-fx-background-color: #7f8c8d; -fx-text-fill: white; -fx-font-size: 13px; -fx-padding: 8 20;" text="Limpiar" />
    </HBox>

    <Separator />

    <!-- Sección de Búsqueda -->
    <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #34495e;" text="Buscar Producto (Presione ENTER)" />

    <TextField fx:id="txtBuscar" onKeyPressed="#buscarProducto" promptText="Ingrese código del producto" />

    <Separator />

    <!-- Resultados -->
    <Label fx:id="lblResultado" style="-fx-font-size: 13px;" text="" />

    <Label fx:id="lblInfoProducto" style="-fx-font-size: 12px; -fx-text-fill: #555;" text="" wrapText="true" />

    <Separator />

    <!-- Estadísticas -->
    <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Estadísticas del Inventario" />

    <Label fx:id="lblTotalProductos" style="-fx-font-size: 13px; -fx-text-fill: #27ae60;" text="Total productos: 0" />

    <Label fx:id="lblValorInventario" style="-fx-font-size: 13px; -fx-text-fill: #3498db;" text="Valor inventario: C$ 0.00" />

</VBox>
